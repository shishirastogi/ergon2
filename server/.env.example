# Ergon server environment
# Cloud (Neon): paste POOLED connection string into DATABASE_URL and the
# unpooled one into DIRECT_URL, then delete/rename the two LOCAL_* lines.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Local fallback (portable PostgreSQL 17 in .pgsql/, started via scripts/pg-start.ps1)
DATABASE_URL_LOCAL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/ergon?schema=public

PORT=4000
NODE_ENV=development

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=REPLACE_WITH_RANDOM_32PLUS_CHAR_SECRET
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost

# Google OAuth (ID-token flow). Get a client ID: console.cloud.google.com ->
# APIs & Services -> Credentials -> OAuth client ID -> Web application.
# Authorized JavaScript origins must include your frontend origin(s).
GOOGLE_CLIENT_ID=
# GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# Neon Auth (Managed Better Auth) - paste your project's Auth Base URL from
# Neon Console -> Auth -> Configuration. When set, passwords are managed by
# Neon (users sync into neon_auth.user); leave empty for local bcrypt auth.
NEON_AUTH_BASE_URL=
